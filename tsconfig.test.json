{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node10",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-dist"
  },
  "include": ["src/config.ts", "src/data", "src/lib", "src/hooks/useCart.ts", "src/components", "src/pages", "tests"]
}
